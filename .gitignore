# Claude Code worktrees (temp directories, never commit)
.claude/worktrees/

# Node / build artifacts (if any)
node_modules/
docs/_app.jsx

# Playwright test outputs
test-results/
playwright-report/

# Mutated source trees the negative-control runners build and then delete. The
# trailing slash matters: the ctl_*.js runners themselves are tracked.
tests/source/ctl*/

# Local env (credentials — never commit)
.env.local
